# Required: Absolute path to storage directory outside document root
TELEMETRY_DATA_DIR=/var/lib/telemetry

# Optional: Comma-separated list of allowed domains for origin reporting
TELEMETRY_ALLOWED_HOSTS=localhost,127.0.0.1,example.com,app.example.com

# Optional: Comma-separated list of monitored services
TELEMETRY_SERVICES=app,web,api,dashboard

# Optional: Comma-separated list of recognized UI screen names
TELEMETRY_ALLOWED_SCREENS=root,dashboard,login,account,settings,home

# Optional: Rate limiting settings
TELEMETRY_REQUESTS_PER_MINUTE=600
TELEMETRY_PEER_REQUESTS_PER_MINUTE=120
TELEMETRY_MAX_BYTES=67108864
TELEMETRY_MAX_ROWS=100000

# Optional: Critical alert webhook (Slack or Discord)
# CSP_WEBHOOK_URL=https://hooks.slack.com/services/...
# TELEMETRY_WEBHOOK_ORIGINS=https://hooks.slack.com,https://discord.com
